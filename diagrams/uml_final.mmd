classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +add_task(task) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +list_tasks() list~Task~
    }

    class Task {
        +str title
        +str pet_name
        +str time
        +int duration_minutes
        +str priority
        +date due_date
        +str frequency
        +bool completed
        +int task_id
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +list~Task~ tasks
        +add_task(task) None
        +sort_by_time(tasks) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(task_id, completed_on) Task
        +next_available_slot(date, duration, start, end) str
        +save_to_json(path, owner) None
        +load_from_json(path) tuple~Owner, Scheduler~
    }

    Owner "1" o-- "0..*" Pet : cares for
    Scheduler "1" o-- "0..*" Task : schedules
    Pet "1" o-- "0..*" Task : cares for
    Scheduler --> Owner : coordinates household